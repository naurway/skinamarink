{
	"schemaVersion": 1,
	"id": "skinamarink",
	"version": "${version}",
	"name": "Skinamarink",
	"description": "A liminal-space horror mod where an LLM-backed entity paces its own dread through absence, drift, and demands rather than jump scares.",
	"authors": [
		"naurway"
	],
	"contact": {
		"homepage": "https://github.com/naurway/skinamarink",
		"sources": "https://github.com/naurway/skinamarink"
	},
	"license": "CC0-1.0",
	"icon": "assets/skinamarink/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.naurway.skinamarink.SkinamarinkMod"
		],
		"client": [
			"com.naurway.skinamarink.client.SkinamarinkModClient"
		]
	},
	"mixins": [
		"skinamarink.mixins.json",
		{
			"config": "skinamarink.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}